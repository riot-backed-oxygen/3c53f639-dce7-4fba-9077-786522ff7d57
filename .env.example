PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=your_database

# Javbus API (server-side only)
JAVBUS_API_URL=https://your-api-host
JAVBUS_API_TOKEN=your_token

# Optional: MyMemory works without a key or email.
# Supply your own email to request the provider's higher free daily quota.
MYMEMORY_EMAIL=

# Optional: render, proxy hop count, or trusted proxy IPs/CIDRs (comma-separated).
# Empty on Render: trust private/loopback and Cloudflare proxies by address, not hop count.
# TRUST_PROXY=render explicitly enables this mode; old value 1 on Render also uses it.
# Empty locally = direct IP. Use 0 to disable proxy trust. Same-machine Nginx: loopback.
# Never trust arbitrary forwarding headers from the public internet.
TRUST_PROXY=
